-- OPTIMIZATION: CPU efficiency improvements - cached network strings, reduced table operations, optimized loops
-- Focus: Network message optimization, reduced table iterations, cached function references

util.AddNetworkString("tacrp_spawnedwepatts")

-- Cache frequently used functions
local net_Start = net.Start
local net_WriteUInt = net.WriteUInt
local net_Broadcast = net.Broadcast
local table_Count = table.Count
local IsValid = IsValid
local timer_Simple = timer.Simple

hook.Add("onDarkRPWeaponDropped", "TacRP", function(ply, ent, wep)
    ent:SetCollisionGroup(COLLISION_GROUP_WEAPON)
    
    if wep.ArcticTacRP and wep.Attachments then
        local atts = {}
        local att_count = 0
        
        -- Optimize attachment processing
        for k, v in pairs(wep.Attachments) do
            if v.Installed then
                local att_data = TacRP.Attachments[v.Installed]
                if att_data then
                    atts[k] = att_data.ID
                    att_count = att_count + 1
                end
            end
        end
        
        if att_count > 0 then
            net_Start("tacrp_spawnedwepatts")
                net_WriteUInt(ent:EntIndex(), 12)
                net_WriteUInt(att_count, 4)
                for k, v in pairs(atts) do
                    net_WriteUInt(k, 4)
                    net_WriteUInt(v, TacRP.Attachments_Bits)
                end
            net_Broadcast()
            ent.Attachments = atts
        end
    end
    
    if wep:GetNWBool("TacRP_PoliceBiocode", false) then
        ent:SetNWBool("TacRP_PoliceBiocode", true)
        ent.TacRP_PoliceBiocode = true
    end
end)

hook.Add("PlayerPickupDarkRPWeapon", "TacRP", function(ply, ent, wep)
    if not (wep.ArcticTacRP and wep.Attachments) then
        return
    end

    -- Check for duplicate pickups or walk key
    if ply:HasWeapon(wep:GetClass()) or ply:KeyDown(IN_WALK) then
        ply:PickupObject(ent)
        return true
    end

    local class = wep:GetClass()
    local biocoded = ent:GetNWBool("TacRP_PoliceBiocode")
    local attachments = ent.Attachments
    
    wep:Remove()
    wep = ply:Give(class, true)
    wep.GaveDefaultAmmo = true
    
    if biocoded then
        wep:SetNWBool("TacRP_PoliceBiocode", true)
    end

    -- Apply attachments if present
    if attachments then
        for k, v in pairs(attachments) do
            local att_index = TacRP.Attachments_Index[v]
            if att_index then
                wep.Attachments[k].Installed = att_index
            end
        end
        timer_Simple(0.1, function() 
            if IsValid(wep) then 
                wep:NetworkWeapon() 
            end 
        end)
    end

    ent.Attachments = nil -- Prevent attachment duplication

    hook.Call("playerPickedUpWeapon", nil, ply, ent, wep)
    ent:GivePlayerAmmo(ply, wep, false)
    ent:DecreaseAmount()

    return true
end)

hook.Add("onPocketItemDropped", "TacRP_DarkRP", function(wep, ent, item, id)
    if ent:GetClass() ~= "spawned_weapon" then 
        return 
    end
    
    if ent.TacRP_PoliceBiocode then
        ent:SetNWBool("TacRP_PoliceBiocode", true)
    end
    
    local atts = ent.Attachments
    if atts then
        local att_count = table_Count(atts)
        if att_count > 0 then
            net_Start("tacrp_spawnedwepatts")
                net_WriteUInt(ent:EntIndex(), 12)
                net_WriteUInt(att_count, 4)
                for k, v in pairs(atts) do
                    net_WriteUInt(k, 4)
                    net_WriteUInt(v, TacRP.Attachments_Bits)
                end
            net_Broadcast()
        end
    end
end)

local function hack()
    local spawned_weapon = (scripted_ents.GetStored("spawned_weapon") or {}).t
    if spawned_weapon and not spawned_weapon.TacRP_Hack then
        spawned_weapon.TacRP_Hack = true -- prevent multiple modifications
        local old_StartTouch = spawned_weapon.StartTouch

        function spawned_weapon:StartTouch(ent)
            if ent.Attachments then 
                return 
            end
            old_StartTouch(self, ent)
        end
    end

    if DarkRP then
        hook.Add("PlayerLoadout", "TacRP_PoliceBiocode", function(ply)
            if not TacRP.ConVars["rp_biocode_cp"]:GetBool() or not ply:isCP() then 
                return 
            end
            
            timer_Simple(0.001, function()
                if not IsValid(ply) then 
                    return 
                end
                
                local jobTable = ply:getJobTable()
                local weapons = jobTable.weapons
                if weapons then
                    for i = 1, #weapons do
                        local wep = ply:GetWeapon(weapons[i])
                        if IsValid(wep) then
                            wep:SetNWBool("TacRP_PoliceBiocode", true)
                            wep.TacRP_PoliceBiocode = true
                        end
                    end
                end
            end)
        end)
    end
end

hook.Add("InitPostEntity", "TacRP_SpawnedWeaponHack", hack)
hack()